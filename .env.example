# Copia este archivo como .env y llena los valores. El .env nunca se sube al repo.

# Supabase (la clave pública es la publishable/anon; nunca la service_role)
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# true = demo de solo lectura con franja y usuarios de prueba visibles
PUBLIC_DEMO_MODE=false

# Login del POS
# SESSION_SECRET: texto aleatorio de mínimo 32 caracteres. Genéralo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
POS_ADMIN_USER=
POS_ADMIN_PASS=
POS_EMPLEADO_USER=
POS_EMPLEADO_PASS=
